# Postgres — superusuario, solo se usa para el bootstrap de bases/usuarios (sql/00_init.sh)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Credenciales propias de cada microservicio.
# sql/00_init.sh crea estos usuarios y sus bases; cada MS se conecta SOLO con la suya.
USUARIOS_DB_PASSWORD=usuarios_pass
EJERCICIOS_DB_PASSWORD=ejercicios_pass
ENTRENAMIENTO_DB_PASSWORD=entrenamiento_pass

# Autenticación (gateway y ms-usuarios firman/verifican con el mismo secreto)
JWT_SECRET=cambiar_este_secreto

# Puertos expuestos al host
GATEWAY_PORT=3000
USUARIOS_PORT=3001
EJERCICIOS_PORT=3002
MEDIA_PORT=3003
ENTRENAMIENTO_PORT=3004

# URLs internas entre contenedores (nombre de servicio de docker-compose, no localhost)
USUARIOS_URL=http://ms-usuarios:3001
EJERCICIOS_URL=http://ms-ejercicios:3002
MEDIA_URL=http://ms-media:3003
ENTRENAMIENTO_URL=http://ms-entrenamiento:3004

# URL pública del gateway, tal como la ve el navegador. MS-Media la usa para armar
# la URL de cada archivo subido: el navegador nunca debe llamar directo al puerto 3003.
PUBLIC_GATEWAY_URL=http://localhost:3000
